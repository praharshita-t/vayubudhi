# Copy to .env on each host. Never commit real values.
COMPOSE_PROJECT_NAME=vayubudhi
DOMAIN=air.example.com
APP_ENV=production
POSTGRES_DB=vayubudhi
POSTGRES_USER=vayuuser
# Generate independent secrets with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://vayuuser:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/vayubudhi
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=
ALLOWED_ORIGINS=https://air.example.com
SEED_DEMO_USERS=false
INGESTION_ENABLED=false
INGESTION_INTERVAL_SECONDS=900
SENSOR_API_KEY=
DATAGOV_API_KEY=
OPENAQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TOMTOM_API_KEY=
MOBILE_WEBHOOK_URL=
MOBILE_WEBHOOK_SECRET=
BACKEND_IMAGE=ghcr.io/praharshita-t/vayubudhi-backend:RELEASE_SHA
FRONTEND_IMAGE=ghcr.io/praharshita-t/vayubudhi-frontend:RELEASE_SHA
